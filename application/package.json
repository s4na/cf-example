{
  "name": "@cf-example/application",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm cloudflare:check",
    "cloudflare:check": "vite build && wrangler deploy --dry-run --assets ./dist/client --config ../infrastructure/cloudflare/wrangler.jsonc --outdir ../.artifacts/worker",
    "dev": "vite",
    "format:check": "oxfmt --check .",
    "lint": "oxlint src tests vite.config.ts vitest.config.ts",
    "test": "pnpm test:unit && pnpm test:worker",
    "test:unit": "vitest run --coverage --config vitest.config.ts",
    "test:worker": "vite build && vitest run --config vitest.worker.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.10.0",
    "preact": "^10.27.0",
    "valibot": "^1.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.47.0",
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@cloudflare/workers-types": "^5.0.0",
    "@preact/preset-vite": "^2.10.2",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/preact": "^3.2.4",
    "@vitest/coverage-v8": "^4.0.0",
    "jsdom": "^26.1.0",
    "oxfmt": "^0.12.0",
    "oxlint": "^1.13.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vitest": "^4.0.0",
    "wrangler": "^4.114.0"
  }
}
