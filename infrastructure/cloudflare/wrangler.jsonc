{
  "$schema": "../../application/node_modules/wrangler/config-schema.json",
  "name": "cf-example",
  "main": "../../application/src/server/index.ts",
  "compatibility_date": "2026-07-29",
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cf-example",
      "migrations_dir": "migrations"
    }
  ]
}
